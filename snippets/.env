# SMTP genérico (Gmail, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha_de_app

# Remetente padrão
MAIL_FROM="Kids Tales <noreply@kids-tales.com>"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Ghost
GHOST_URL=http://localhost:2368
GHOST_ADMIN_API_KEY=key_id:secret   # Settings → Integrations → Add custom integration

# Gemini
GEMINI_API_KEY=sua_chave_aqui       # aistudio.google.com/app/apikey

# Asaas
ASAAS_API_KEY=$aact_seu_token_aqui
ASAAS_ENV=sandbox   # sandbox | production
